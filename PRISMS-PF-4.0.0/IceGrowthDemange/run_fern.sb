#!/bin/bash
#SBATCH --job-name=Fern
#SBATCH --nodes=1
#SBATCH --ntasks=16
#SBATCH --ntasks-per-node=16
#SBATCH --cpus-per-task=1
#SBATCH --mem=150G
#SBATCH --time=72:00:00
#SBATCH --partition=cpu
#SBATCH --output=slurm-%x-%j.out
#SBATCH --error=slurm-%x-%j.err
# Minimal launch wrapper; no field conversion or restart machinery.
# Example: sbatch --account=YOUR_ACCOUNT run_fern.sb configs/paper_fern_dendrite_amr_t500.prm Fern_320_ON
set -euo pipefail
module purge
module load foss/2023b CMake/3.27.6
cd "$SLURM_SUBMIT_DIR"
CFG="${1:?Usage: sbatch run_fern.sb CONFIG.prm [run_name]}"
[ -f "$CFG" ] || { echo "Missing parameter file: $CFG" >&2; exit 1; }
NAME="${2:-$(basename "$CFG" .prm)}"
case "$NAME" in
  ''|*[!A-Za-z0-9._-]*) echo "Invalid run name: $NAME" >&2; exit 1 ;;
esac
APP="$(pwd -P)"
BIN="$APP/build/main"
RUN="$APP/runs/$NAME"
[ -x "$BIN" ] || { echo "Application executable not found: $BIN" >&2; exit 1; }
[ ! -e "$RUN" ] || { echo "Run directory already exists: $RUN" >&2; exit 1; }
mkdir -p "$RUN"
cp "$CFG" "$RUN/parameters.prm"
cd "$RUN"
mpirun -np "$SLURM_NTASKS" "$BIN" -i parameters.prm > run.log 2> run.err
